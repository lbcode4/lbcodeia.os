# Copie pra .env e preencha. .env NÃO vai pro git (ver .gitignore).
# Nem toda chave é obrigatória — depende das skills que você usa.

# --- Assistente IA (chat do front) ---
ANTHROPIC_API_KEY=

# --- Geração de imagem IA (skills /carrossel e /site) ---
# Gemini nano-banana (preferencial — aceita refs visuais da marca)
GEMINI_API_KEY=
# OpenAI (fallback — sem refs visuais)
OPENAI_API_KEY=
# (opcional) modelo default de cada provedor — também dá pra passar por argumento no script
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image       # ou gemini-3-pro-image-preview | gemini-3.1-flash-image-preview
# OPENAI_IMAGE_MODEL=gpt-image-1                   # ou gpt-image-2

# --- Publicação automática no feed (skill /aprovar-post) ---
# Token de longa duração da Página do Facebook
META_PAGE_ACCESS_TOKEN=
# ID da Página do Facebook
META_PAGE_ID=
# ID da conta Instagram Business conectada à Página
META_IG_USER_ID=
# URL pública do site (a Meta busca as imagens por URL) — ex: https://exemplo.com.br
SITE_URL=
